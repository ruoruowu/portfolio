# Password gate — see src/lib/gate.ts.
#
# GATE_PASSWORD is the fallback for every gate. Give one gate its own password
# with GATE_PASSWORD_<SLUG>, the slug upper-cased with dashes as underscores:
# <Gate slug="acme-nda"> reads GATE_PASSWORD_ACME_NDA.
#
# A gate with no password configured stays locked for everyone — a missing
# variable hides a page rather than publishing it.
GATE_PASSWORD=

# Optional. Keys the cookie's digest. Without it the password keys its own
# cookie, which means changing a password signs out everyone holding the old
# one — usually what you want. Set it if you would rather rotate access
# independently of the passwords. Any long random string.
GATE_SECRET=

# Set to 1 to expose /lab/gate (the animation preview) on a production deploy.
# Off by default; it is always available in `next dev`.
GATE_LAB=
